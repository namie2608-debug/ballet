<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>芭蕾手部第一位置（First Position）體感評測機</title>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/pose/pose.js" crossorigin="anonymous"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #121212;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    #stage-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      max-width: 1280px;
      max-height: 720px;
      background: #000;
    }
    video { display: none; }
    canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }
    .hud-header {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.75);
      border: 3px solid #00E676;
      padding: 10px 24px;
      border-radius: 30px;
      font-size: 22px;
      font-weight: bold;
      text-align: center;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .timer-badge {
      position: absolute;
      top: 20px;
      left: 20px;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: rgba(0,0,0,0.7);
      border: 4px solid #FF5252;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      font-size: 28px;
      font-weight: 800;
    }
    .timer-badge span {
      font-size: 11px;
      color: #aaa;
      margin-top: -2px;
    }
    .energy-bar-container {
      position: absolute;
      right: 25px;
      top: 100px;
      bottom: 100px;
      width: 28px;
      background: rgba(255,255,255,0.15);
      border: 2px solid #fff;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column-reverse;
    }
    .energy-bar-fill {
      width: 100%;
      height: 0%;
      background: #FF5252;
      transition: height 0.1s ease-out, background-color 0.2s;
    }
    .score-text {
      position: absolute;
      right: 15px;
      bottom: 60px;
      font-size: 22px;
      font-weight: bold;
      color: #fff;
      width: 50px;
      text-align: center;
    }
  </style>
</head>
<body>

<div id="stage-container">
  <video id="webcam" playsinline></video>
  <canvas id="output-canvas"></canvas>

  <div class="timer-badge" id="timer-badge">
    <div id="hold-sec">0</div>
    <span>HOLD(S)</span>
  </div>

  <div class="hud-header" id="status-card">
    站入畫面，雙手於下胸抱圓
  </div>

  <div class="energy-bar-container">
    <div class="energy-bar-fill" id="energy-fill"></div>
  </div>
  <div class="score-text" id="score-text">0%</div>
</div>

<script>
  const videoElement = document.getElementById('webcam');
  const canvasElement = document.getElementById('output-canvas');
  const canvasCtx = canvasElement.getContext('2d');
  const statusCard = document.getElementById('status-card');
  const energyFill = document.getElementById('energy-fill');
  const scoreText = document.getElementById('score-text');
  const holdSecText = document.getElementById('hold-sec');
  const timerBadge = document.getElementById('timer-badge');

  let holdCounter = 0;

  function calculateAngle(a, b, c) {
    const radians = Math.atan2(c.y - b.y, c.x - b.x) - Math.atan2(a.y - b.y, a.x - b.x);
    let angle = Math.abs(radians * 180.0 / Math.PI);
    if (angle > 180.0) angle = 360 - angle;
    return Math.round(angle);
  }

  function onResults(results) {
    canvasElement.width = videoElement.videoWidth;
    canvasElement.height = videoElement.videoHeight;
    const w = canvasElement.width;
    const h = canvasElement.height;

    canvasCtx.save();
    canvasCtx.clearRect(0, 0, w, h);
    canvasCtx.drawImage(results.image, 0, 0, w, h);

    let accuracy = 0;
    let status = "站入畫面，雙手於下胸抱圓";
    let statusColor = "#FFA726";

    if (results.poseLandmarks) {
      const lm = results.poseLandmarks;

      const lShoulder = lm[11], rShoulder = lm[12];
      const lElbow = lm[13], rElbow = lm[14];
      const lWrist = lm[15], rWrist = lm[16];
      const lHip = lm[23], rHip = lm[24];

      // 1. 計算左右手臂夾角 (肩 - 肘 - 腕)
      const leftElbowAngle = calculateAngle(lShoulder, lElbow, lWrist);
      const rightElbowAngle = calculateAngle(rShoulder, rElbow, rWrist);

      // 2. 距離與比例
      const shoulderWidth = Math.abs(lShoulder.x - rShoulder.x);
      const wristDist = Math.abs(lWrist.x - rWrist.x);

      // 3. 高度基準：肩膀高度與髖骨高度
      const avgShoulderY = (lShoulder.y + rShoulder.y) / 2;
      const avgHipY = (lHip.y + rHip.y) / 2;
      const avgWristY = (lWrist.y + rWrist.y) / 2;
      const avgElbowY = (lElbow.y + rElbow.y) / 2;

      // 下胸理想位置區間：約為肩膀到髖部上方 25% ~ 55% 的垂直位置
      const chestTopY = avgShoulderY + (avgHipY - avgShoulderY) * 0.20;
      const chestBottomY = avgShoulderY + (avgHipY - avgShoulderY) * 0.60;
      const isAtLowerChest = (avgWristY >= chestTopY && avgWristY <= chestBottomY);

      // --- 評分核心 ---
      // A. 手肘弧度（110° ~ 160° 抱圓弧形，滿分 40）
      let scoreElbow = 0;
      if (leftElbowAngle >= 110 && leftElbowAngle <= 160 && rightElbowAngle >= 110 && rightElbowAngle <= 160) {
        scoreElbow = 40;
      } else if (leftElbowAngle > 165 || rightElbowAngle > 165) {
        scoreElbow = 15; // 手臂太直
      } else {
        scoreElbow = 25;
      }

      // B. 雙手抱圓間距（手腕距離適中，肩寬的 0.15 ~ 0.65 倍，滿分 30）
      let scoreDist = 0;
      if (wristDist >= shoulderWidth * 0.15 && wristDist <= shoulderWidth * 0.65) {
        scoreDist = 30;
      } else if (wristDist > shoulderWidth * 0.65) {
        scoreDist = 10; // 間距過開
      } else {
        scoreDist = 15;
      }

      // C. 高度檢核（手腕必須落在下胸位置，滿分 30）
      let scoreHeight = 0;
      if (isAtLowerChest) {
        scoreHeight = 30;
      } else if (avgWristY < chestTopY) {
        scoreHeight = 10; // 太高（抬到喉嚨或鎖骨）
      } else {
        scoreHeight = 10; // 太低（掉到下腹或大腿）
      }

      accuracy = Math.min(100, Math.max(0, scoreElbow + scoreDist + scoreHeight));

      // 繪製骨骼與光軌
      function drawBone(p1, p2, color, thickness) {
        canvasCtx.beginPath();
        canvasCtx.moveTo(p1.x * w, p1.y * h);
        canvasCtx.lineTo(p2.x * w, p2.y * h);
        canvasCtx.lineWidth = thickness;
        canvasCtx.strokeStyle = color;
        canvasCtx.stroke();
      }

      drawBone(lShoulder, rShoulder, '#FFFFFF', 3);
      drawBone(lShoulder, lElbow, '#00E5FF', 4);
      drawBone(lElbow, lWrist, '#00E5FF', 4);
      drawBone(rShoulder, rElbow, '#00E5FF', 4);
      drawBone(rElbow, rWrist, '#00E5FF', 4);
      // 雙手間虛擬圓弧導引連線
      drawBone(lWrist, rWrist, accuracy >= 85 ? '#00E676' : 'rgba(255,255,255,0.4)', 2);

      const pts = [lShoulder, rShoulder, lElbow, rElbow, lWrist, rWrist];
      pts.forEach(p => {
        canvasCtx.beginPath();
        canvasCtx.arc(p.x * w, p.y * h, 7, 0, 2 * Math.PI);
        canvasCtx.fillStyle = '#00E676';
        canvasCtx.fill();
        canvasCtx.lineWidth = 2;
        canvasCtx.strokeStyle = '#FFFFFF';
        canvasCtx.stroke();
      });

      // 即時提示文字與秒數倒數
      if (accuracy
